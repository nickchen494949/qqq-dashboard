    <section class="component comp-related-topics m-bottom-56" data-component="Related Topics (injected)">
        <div class="comp-related-topics__container">
            <div class="component comp-heading-divider">
                <h2>
                    Topics
                </h2>
                <hr />
            </div>

            <div class="comp-filter__facets remove-x">
                        <a data-category="Production and Investment"
                            href="/topics/production_and_investment"
                            class="comp-filter__pill no_link_image">
                            Production and Investment
                        </a>
                        <a data-category="Household and Consumer Finance"
                            href="/topics/household_and_consumer_finance"
