            }

            self.ResetFilters = function () {
                document.querySelector('#filter_feed_b60d575d40ad4b9888c30b5536df026c81585a29cf3b4080abffec704d9ebd81').reset();
                self.UpdatePageInput(1);

                // sync the filter form inputs with hidden input values
                UpdateFormInputs();

                const formData = self.GetFormData('#filter_feed_b60d575d40ad4b9888c30b5536df026c81585a29cf3b4080abffec704d9ebd81');
                const queryString = new URLSearchParams(formData).toString();
                self.GetFilteredFeed(queryString);
                UpdateUrlQueryParams(new FormData());
            }

            self.UpdatePageInput = function (page) {
                document.querySelector('#feed_b60d575d40ad4b9888c30b5536df026c81585a29cf3b4080abffec704d9ebd81_pageNumber').value = page;
            }

            self.GetFormData = function (formSelector) {
                const formData = new FormData();
                const form = document.querySelector(formSelector);
                const elements = form.querySelectorAll('input[type="hidden"]');

                elements.forEach(input => {
                    if (input.value.length > 0) {
                        formData.append(input.name, input.value);
                    }
                });

                return formData;
            }

            self.GetFilteredFeed = function (queryString) {
                const url = `/api/feed/getFilteredResults?${queryString}`;
                self.isLoading(true);
                document.querySelector("#feed_b60d575d40ad4b9888c30b5536df026c81585a29cf3b4080abffec704d9ebd81").scrollIntoView({ behavior: "smooth" });

                fetch(url).then(function (response) {
                    if (!response.ok)
                        throw new Error(`Response status: ${response.status}`);

                    if (response.status != 200)
                        return null;

                    return response.json();

                }).then(data => {
                    if (data == null) {
                        self.items.removeAll();
                        self.pagination.removeAll();
                        return;
                    }

                    self.items(JSON.parse(data.FilteredFeedItemsJson));
                    self.pagination(JSON.parse(data.PaginationLinksJson));

                }).then(() => {
                    self.isLoading(false);
                }).catch(function (err) {
                    self.items.removeAll();
                    self.pagination.removeAll();
                    self.isLoading(false);
                    console.warn('Something went wrong.', err);
                });
            }

            self.Initialize = function () {
                const params = new URLSearchParams(window.location.search);
                const entries = Object.fromEntries(params.entries());
                let pageNumberParam = '';
                let topicsParam = '';
                let contentTypesParam = '';
                let authorsParam = '';
                let startDateRangeParam = '';
                let endDateRangeParam = '';

                for (const property in entries) {
                    if (property == 'page') {
                        pageNumberParam = entries[property];
                    }
                    if (property === 'topics') {
                        topicsParam = entries[property];
                    }
                    if (property === 'ctypes') {
                        contentTypesParam = entries[property];
                    }
                    if (property === 'authors') {
                        authors = entries[property];
                    }
                    if (property === 'start') {
                        startDateRangeParam = entries[property];
                    }
                    if (property === 'end') {
                        endDateRangeParam = entries[property];
                    }
                }

                const filterForm = document.querySelector('#filter_feed_b60d575d40ad4b9888c30b5536df026c81585a29cf3b4080abffec704d9ebd81');
                let topicsArr = [];
                let contentTypesArr = [];
                let authorsArr = [];

                // update pageNumber hiddenField
                const pageNumber = filterForm.querySelector('input[name="PageNumber"]');
                if (pageNumberParam.length > 0) {
                    pageNumber.value = pageNumberParam;
                }

                // update filterTopics hiddenField
                const filterTopics = filterForm.querySelector('input[name="FilterTopics"]');
                if (topicsParam.length > 0) {
                    filterTopics.value = topicsParam;
                    topicsArr = filterTopics.value.split(',');
                }

                //update filterContentTypes hiddenField
                const filterContentTypes = filterForm.querySelector('input[name="FilterContentTypes"]');
                if (contentTypesParam.length > 0) {
                    filterContentTypes.value = contentTypesParam;
                    contentTypesArr = filterContentTypes.value.split(',');
                }

                // update filterAuthors hiddenField
                const filterAuthors = filterForm.querySelector('input[name="FilterAuthors"]');
                if (authorsParam.length > 0) {
                    filterAuthors.value = authorsParam;
                    authorsArr = filterAuthors.value.split(',');
                }

                // update startDateRange hiddenField
                const startDateRange = filterForm.querySelector('input[name="StartDateRange"]');
                if (startDateRangeParam.length > 0) {
                    startDateRange.value = startDateRangeParam;
                }

                // update endDateRange hiddenField
                const endDateRange = filterForm.querySelector('input[name="EndDateRange"]');
                if (endDateRangeParam.length > 0) {
                    endDateRange.value = endDateRangeParam;
                }

                // update StartDate input
                const startDateInput = filterForm.querySelector('input[name="StartDate"]');
                if (startDateRangeParam.length > 0) {
                    startDateInput.value = startDateRangeParam;
                }

                // update EndDate input
                const endDateInput = filterForm.querySelector('input[name="EndDate"]');
                if (endDateRangeParam.length > 0) {
                    endDateInput.value = endDateRangeParam;
                }

                // update Topics input
                if (topicsArr.length > 0) {
                    const topicsInput = filterForm.querySelectorAll('input[name="Topics"]');
                    topicsInput.forEach((element) => {
                        if (topicsArr.includes(element.value))
                            element.checked = true;
                    });
                }

                // update ContentTypes input
                if (contentTypesArr.length > 0){
                    const contentTypesInput = filterForm.querySelectorAll('input[name="ContentTypes"]');
                    contentTypesInput.forEach((element) => {
                        if (contentTypesArr.includes(element.value))
                            element.checked = true;
                    });
                }

                // update Authors input
                if (authorsArr.length > 0) {
                    const authorsInput = filterForm.querySelectorAll('input[name="Authors"]');
                    authorsInput.forEach((element) => {
                        if (authorsArr.includes(element.value))
                            element.checked = true;
                    });
                }
            }

            self.Initialize();
        }

        document.addEventListener("DOMContentLoaded", function () {
            ko.applyBindings(new AppViewModel());
        });

    </script>
    <!-- other functions -->
    <script type="text/javascript">

        function UpdateFormInputs() {
            const filterForm = document.querySelector('#filter_feed_b60d575d40ad4b9888c30b5536df026c81585a29cf3b4080abffec704d9ebd81');

            const topics = filterForm.querySelectorAll('input[name="Topics"]');;
            const contentTypes = filterForm.querySelectorAll('input[name="ContentTypes"]');;
            const authors = filterForm.querySelectorAll('input[name="Authors"]');
            const startDate = filterForm.querySelector('input[name="StartDate"]');
            const endDate = filterForm.querySelector('input[name="EndDate"]');

            let topicsToAdd = [];
            let contentTypesToAdd = [];
            let authorsToAdd = [];

            topics.forEach((element) => {
                if (element.checked) topicsToAdd.push(element.value);
            });

            contentTypes.forEach((element) => {
                if (element.checked) contentTypesToAdd.push(element.value);
            });

            authors.forEach((element) => {
                if (element.checked) authorsToAdd.push(element.value);
            });

            const hiddenTopicValue = GetNewHiddenValue(topicsToAdd);
            const hiddenContentTypeValue = GetNewHiddenValue(contentTypesToAdd);
            const hiddenAuthorValue = GetNewHiddenValue(authorsToAdd);

            let filterTopicsUpdate = filterForm.querySelector('input[name="FilterTopics"]');
            let filterContentTypesUpdate = filterForm.querySelector('input[name="FilterContentTypes"]');
            let filterAuthorsUpdate = filterForm.querySelector('input[name="FilterAuthors"]');
            let filterStartDateRangeUpdate = filterForm.querySelector('input[name="StartDateRange"]');
            let filterEndDateRangeUpdate = filterForm.querySelector('input[name="EndDateRange"]');

            filterTopicsUpdate.value = hiddenTopicValue;
            filterContentTypesUpdate.value = hiddenContentTypeValue;
            filterAuthorsUpdate.value = hiddenAuthorValue;
            filterStartDateRangeUpdate.value = startDate != null ? startDate.value : "";
            filterEndDateRangeUpdate.value = endDate != null ? endDate.value : "";
        }

        function GetNewHiddenValue(arr) {
            let hiddenValue = '';
            let i = 1;
            arr.forEach((element) => {
                if (i < arr.length) {
                    hiddenValue += `${element},`;
                } else {
                    hiddenValue += `${element}`;
                }
                i++;
            });

            return hiddenValue;
        }

        function UpdateUrlQueryParams(formData) {
            const params = new URLSearchParams();

            for (const [key, value] of formData.entries()) {
                if (key === 'PageNumber') {
                    params.append('page', value);
                }
                if (key === 'FilterTopics') {
                    params.append('topics', value);
                }
                if (key === 'FilterContentTypes') {
                    params.append('ctypes', value);
                }
                if (key === 'FilterAuthors') {
                    params.append('authors', value);
                }
                if (key == 'StartDateRange') {
                    params.append('start', value);
                }
                if (key === 'EndDateRange') {
                    params.append('end', value);
                }
            }

            const newUrl = `${window.location.pathname}?${params.toString()}`;
            window.history.pushState({}, '', newUrl);
        }

    </script>


        </div>
    </main>
