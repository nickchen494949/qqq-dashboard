				<title>Icon for Facebook</title>
				<path d="M6.07143 0C2.99844 0 0.5 2.49844 0.5 5.57143V33.4286C0.5 36.5016 2.99844 39 6.07143 39H14.6201V26.3076H10.0237V19.5H14.6201V16.5663C14.6201 8.98393 18.05 5.46696 25.5018 5.46696C26.9121 5.46696 29.3496 5.74554 30.3507 6.02411V12.1875C29.8283 12.1353 28.9143 12.1004 27.7739 12.1004C24.1176 12.1004 22.7074 13.4846 22.7074 17.0799V19.5H29.985L28.7315 26.3076H22.6987V39H33.9286C37.0016 39 39.5 36.5016 39.5 33.4286V5.57143C39.5 2.49844 37.0016 0 33.9286 0H6.07143Z" fill="white"/>
