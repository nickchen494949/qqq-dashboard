                <div class="header-group">
                    <div id="page-title" class="page-title">
                        <h2>
                            Speech
                        </h2>
                    </div>
                    <div class="shareDL">
                        <a type="button" href="/newsevents/speech/files/stein20121217a.pdf" class="btn shareDL__button">
