       <img src="/-/media/project/clevelandfedtenant/clevelandfedsite/collections/speeches/sp-20200902/sp-20200902-img-02-lg.jpg?w=991&hash=6FEFCE1F39295BDC9048F53E7E50609F" alt="Figure 2. Inflation moved down as the economy shut down" sizes="(min-width:992px) 800px,991px" srcset="/-/media/project/clevelandfedtenant/clevelandfedsite/collections/speeches/sp-20200902/sp-20200902-img-02-lg.jpg?w=991&amp;hash=6FEFCE1F39295BDC9048F53E7E50609F 991w,/-/media/project/clevelandfedtenant/clevelandfedsite/collections/speeches/sp-20200902/sp-20200902-img-02-lg.jpg?w=800&amp;hash=C218000511AF3264C22086C70A4176CC 800w" />
    </figure>

</div>
</div>
<div class="component image cf-image-component col-12">


<div class="cf-figure" >
    <figure>
     
            
                <a class="anchor" name=fig003 > </a>
                <div class="cf-figure_return link-button__list-group">
                    <a class="link-button__anchor" href=#fig003-ret>
                        <span class="cf-button--anchor cf-button--up">
                            Return to Figure 3 
                        </span>
