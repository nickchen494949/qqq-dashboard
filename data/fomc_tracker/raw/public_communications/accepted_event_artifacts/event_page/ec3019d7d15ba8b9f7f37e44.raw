03cscript src=\"/js/libs/highcharts9/modules/data.js\"\u003e\u003c/script\u003e"}}},{"id":"d7de6743-c99f-4f8b-bf9c-8d66b09be34b","url":"https://sc103-mplsfed-prod-cd.mac-p-sitecore-ase-6.appserviceenvironment.net/globals/lookup-items/highchart-modules/exporting","name":"Exporting","displayName":"Exporting","fields":{"CodeBlock":{"value":"\u003cstyle type=\"text/css\"\u003e\r\ndiv.highcharts-contextmenu \u003e ul \u003e hr {\r\n margin-top: 1rem !important;\r\n margin-bottom: 1rem !important;\r\n}\r\n\u003c/style\u003e"}}}],"CodeBlock":{"value":"\u003cscript type=\"text/javascript\"\u003e\r\n$(document).ready(function() {\r\n\r\n$.get('~/media/assets/articles/2022/two-opposing-risks/chart1.csv', function(csv) {\r\n\r\n    $('#chart1').highcharts({\r\n        chart: {\r\n            type: 'line'\r\n        },\r\n        data: {\r\n            csv: csv\r\n        },\r\n    title: {\r\n        text: '\u003cdiv style=\"font-size: 16px; color: #fff; font-weight: 600; padding: 5px 8px; background-color: #888888; margin-right: 5px; margin-bottom: 5px; display: inline-block;\"\u003e1\u003c/div\u003e\u003cbr\u003ePCE Inflation',\r\n        useHTML:true,\r\n        style: {\r\n            \tfontWeight: '300',\r\n\t\t\t\tfontSize: '20px',\r\n\t\t\t\tlineHeight: '1.2'\r\n        \t},\r\n\t\t\talign: 'left',\r\n\t\t\tmargin: 15\r\n    },\r\n subtitle: {\r\n            text: '12-month percent change',\r\n\t\t\tstyle: {\r\n            \tfontWeight: '700'\r\n        \t},\r\n\t\t\talign: 'left'\r\n        },\r\n     caption: {\r\n    \t\ttext: 'Source: Bureau of Economic Analysis'\r\n    },\r\n    xAxis: {\r\n         \r\n        plotBands: [{\r\n            color: '#eeefef',\r\n            from: Date.UTC(2020, 1, 1),\r\n            to: Date.UTC(2020, 3, 1)\r\n        }]\r\n    },\r\nplotOptions: {\r\n        series: {\r\n            marker: {\r\n                enabled: false\r\n            }\r\n        }\r\n    },\r\n    yAxis: {\r\n    \t\t\r\n        title: {\r\n            text: