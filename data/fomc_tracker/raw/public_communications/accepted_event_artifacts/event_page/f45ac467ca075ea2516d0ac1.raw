                    <img src="/assets/images/svg/icon-social/linkedin-circle.svg" alt="LinkedIn">
                </a>
            </li>
            <li class="share-circle-icon">
                <a href="https://twitter.com/intent/tweet?url=https%3A%2F%2Fwww.philadelphiafed.org%2Fthe-economy%2Fmonetary-policy%2F230113-survey-results-on-economic-conditions&amp;text=Survey+Results+on+Economic+Conditions" target="_blank">
