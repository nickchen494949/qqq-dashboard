                    <img src="/assets/images/svg/icon-social/facebook-circle.svg" alt="Facebook">
                </a>
            </li>
            <li class="share-circle-icon">
                <a href="https://www.threads.net/intent/post?url=https%3a%2f%2fwww.philadelphiafed.org%2fthe-economy%2fmonetary-policy%2f230113-survey-results-on-economic-conditions&amp;text=Survey+Results+on+Economic+Conditions" target="_blank">
