<style>


  #header {
    font-family: Arial, Helvetica, sans-serif;
    transition: background-color 300ms;
  }

  .is-stuck {
    position: sticky;
    top: 0;
    z-index: 1002;
    width: 100%;
  }

  .frb-nav {
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    background-color: white;
    border: none;
    margin-bottom: 0;
  }

  .nav-top-section {
    display: flex;
    padding: 15px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
  }

  .nav-logo .navbar-brand img {
    height: 36px;
  }

  .navbar-top-links {
    margin-left: auto;
    display: flex;
    align-items: center;
  }

  .navbar-top-links ul.top-menu {
    display: flex;
    list-style: none;
    margin-bottom: 0px;
    font-family: Open Sans, Arial, Helvetica, sans-serif;
  }

  ul.top-menu>li>a {
    color: var(--component-header-secondary-surface, #1262b2);
    font-size: 14px;
    font-weight: 600;
    padding: 10px 15px;
    font-style: normal;
  }

  ul.top-menu>li>a:hover {
    text-decoration: none;
    background-color: transparent !important;
  }

  .navbar-search {
    display: flex;
    align-items: center;
  }

  .nav-search-icon img {
    width: auto;
    display: inline-block;
  }

  .mobile-menu-expand {
    font-weight: bold;
    font-size: 14px;
    color: var(--component-header-secondary-surface, #1262b2);
  }







  /* Menu Expand styles */

  body.nav-expanded {
    overflow-y: hidden;
    background-color: white;
  }

  .mobile-menu-expand-icon {
    height: 26px;
    width: 26px;
  }

  .mobile-menu-expand-icon img {
    max-width: 100%;
    height: auto;
  }


  /* Mobile menu animation styles */
  .nav-bottom-section {
    height: auto;
    overflow: hidden;
    transition: all 300ms;
  }

  #header.expanded .nav-bottom-section {
    height: auto;
  }

  #header .mme-close {
    display: none;
  }

  #header .mme-open {
    display: block;
  }

  #header.expanded {
    background: white;
    height: 100vh;
  }

  #header.expanded .mme-close {
    display: block;
  }

  #header.expanded .mme-open {
    display: none;
  }

  #header.expanded #primary-menu-container {
    display: block;
  }

  #header.expanded .navbar-search {
    margin-left: auto;
  }

  .nav-bottom-section .bottom-menu {
    flex-direction: column;
    align-items: start;
  }



  /* Search Styles */
  .search-close-icn {
    display: none;
    cursor: pointer;
  }

  .search-open-icn {
    display: block;
    cursor: pointer;
  }

  body.search-active {
    overflow: hidden;
  }

  body.search-active .search-close-icn {
    display: block;
  }

  body.search-active .search-open-icn {
    display: none;
  }

  /* Second Level Nav */
  #primary-menu-container {
    background: var(--component-header-secondary-surface, #1262b2);
    font-family: "Merriweather", "Open Sans", sans-serif;
    clear: both;
    padding: 0;
  }

  .bottom-menu {
    display: flex;
    width: 100%;
    justify-content: space-between;
    margin: 0;
    padding: 0;
  }

  .bottom-menu>li {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .bottom-menu>li>a {
    padding: 8px 25px;
    word-wrap: normal;
  }

  .bottom-menu>li:last-child>a {
    border-right: none;
  }

  .primary-menu-title {
    color: white !important;
    font-size: 15px;
    width: 100%;
    text-align: center;
  }

  .primary-menu-title-text {
    display: inline-block;
    vertical-align: middle;
    line-height: 1.2;
    font-weight: normal;
  }

  .nav-menu-card-img-wrapper {
    display: none;
  }

  .navbar-search {
    padding: 5px;
  }

  .search-icon img {
    width: auto;
    display: inline;
  }

  .third-level-menu {
    display: none;
  }

  .measuringWrapper {
    width: 100%;
  }

  .container-fluid {
    position: relative;
  }

  .mobile-menu-items {
    display: block;
  }

  .mobile-menu {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    background-color: rgb(18, 98, 178);
    grid-gap: 2px;
    padding: 0px;
    margin-bottom: 0px;
  }

  ul.mobile-menu:after {
    content: none;
  }

  .mobile-menu li {
    font-family: Open Sans, Arial, Helvetica, sans-serif;
    background-color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 40px
  }

  .mobile-menu li a {
    color: var(--component-header-secondary-surface, #1262B2);
    font-size: 14px;
    font-weight: 600;
  }

  /* Mobile Styles */
  @media (max-width: 990px) {
    .navbar-toggle-mobile-menu {
      all: unset;
      margin-bottom: 0px;
      padding: 0px;
      padding: 0px 15px;
      padding-left: 10px;
      padding-right: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .nav-search-icon {
      padding: 5px;
    }

    .nav-bottom-section {
      height: 0px;
    }

    .bottom-menu {
      flex-direction: column;
    }

    .navbar-top-links {
      display: none;
    }

    .navbar-search {
      margin-left: auto;
    }

    .bottom-menu>li {
      width: 100%;
      position: relative;
      min-height: 40px
    }

    .bottom-menu>li a {
      text-align: left;
    }

    .primary-menu-title-text {
      margin-left: 10px;
    }

    .bottom-menu>li:not(:nth-last-child(-n + 1))::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 25px;
      background-color: var(--component-header-primary-dividers, #0d4680);
      width: calc(100% - 50px);
      height: 2px;
    }
  }

  /* Desktop Only Styles */
  @media (min-width: 991px) {
    .container-fluid button.navbar-toggle-mobile-menu {
      display: none;
      height: 0px;
      width: 0px;
    }

    .nav-top-section {
      padding: 15px 10px 15px 25px
    }

    #primary-menu-container {
      display: flex;
      justify-content: center;
    }

    .nav-bottom-section .bottom-menu {
      flex-direction: row;
      width: unset;
      justify-content: unset;
    }

    .frb-nav .bottom-menu li:not(:last-child) .primary-menu-title::after {
      content: "";
      position: absolute;
      right: 0px;
      background-color: var(--component-header-primary-dividers, #0d4680);
      width: 2px;
      height: 60%;
      top: 20%;
    }

    .navbar-top-links {
      margin-left: auto;
    }

    /* .nav-bottom-section {
      height: auto;
    } */

    .mobile-menu-items {
      height: 0px;
      display: none;
    }

    .frb-nav .top-menu li {
      position: relative;
    }

    .frb-nav .top-menu li a {
      font-style: normal;
    }

    .frb-nav .top-menu li a::after {
      content: "";
      position: absolute;
      bottom: -4px;
      left: 15px;
      background-color: var(--component-header-outline, #f2b600);
      width: 0px;
      height: 2px;
      transition: 0.5s ease-in-out;
    }

    .frb-nav .top-menu li:hover a::after {
      width: calc(100% - 30px);
    }

    .frb-nav .bottom-menu>li>a>span.primary-menu-title-text::after {
      content: "";
      position: absolute;
      bottom: 0px;
      left: 0px;
      background-color: var(--component-header-outline, #f2b600);
      width: 0px;
      height: 4px;
      transition: 0.5s ease-in-out;
    }

    .frb-nav .bottom-menu>li>a:hover span.primary-menu-title-text::after {
      width: 100%;
    }

    .frb-nav .bottom-menu li {
      position: relative;
    }

    /* Bottom Menu Desktop Expand */

    .frb-nav .nav-bottom-section {
      transition: 0.2s ease-in-out;
    }

    .frb-nav .nav-bottom-section.slide-up {
      height: 0px;
      overflow: hidden;
    }
  }

  @media (min-width: 991px) {
    #search-container {
      margin-top: 86px!important;
    }
  }

</style>


