<script type="text/javascript">

    //$('#a2e0ce6614d94f60b89c50f0abcc266c').on('show.bs.collapse', function () {
    //if(!showAllClicked)
    //$('#a2e0ce6614d94f60b89c50f0abcc266c .in').collapse('hide');
    //});

    // callbacks for expand/collapse all buttons
    $('#Accordion_2072fd24be68432e853b5723a94b9ff2 .closeall').on('click', function (evt) {
        evt.preventDefault();
        evt.stopPropagation();
        $('#a2e0ce6614d94f60b89c50f0abcc266c .panel-collapse').collapse('hide');
    });

    $('#Accordion_2072fd24be68432e853b5723a94b9ff2 .openall').on('click', function (evt) {
        evt.preventDefault();
        evt.stopPropagation();
        $('#a2e0ce6614d94f60b89c50f0abcc266c .panel-collapse').collapse('show');
    });

    var initialCollapsed = false;

    function collapseForMobile() {
        if (!initialCollapsed) {
            $('.panel-collapse.in').removeClass('in');
            $('#a2e0ce6614d94f60b89c50f0abcc266c .panel-collapse').collapse('hide');
            initialCollapsed = true;
        }
    }
    $(document).one("min-width-320px", collapseForMobile);
    $(document).one("min-width-480px", collapseForMobile);
    $(document).one("min-width-640px", collapseForMobile);

</script>
