<div class="article-intro article ">

        <div class="intro-image">
            <picture>
                    <source srcset="/-/media/FRBP/Assets/Images/content/Speeches/Anna-Paulson-Headshot/Mobile-Anna-Paulson-Headshot-sm.jpg" media="(max-width: 767px)">
