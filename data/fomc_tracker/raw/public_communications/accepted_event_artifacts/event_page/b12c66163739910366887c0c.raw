			<td class="data" headers="">&nbsp;</td>
			<td class="data" headers="">&nbsp;</td>
		</tr>
		<tr>
			<th class="stub" colspan="7" headers="xt1c1" id="xt1r8">Forces affecting (y<sub>t</sub>-ȳ):</th>
		</tr>
		<tr>
			<th class="stub in1" headers="xt1c1 xt1r8" id="xt1r9"><em>Deregulation + energy</em></th>
			<td class="data" headers="xt1a2 xt1c2 xt1r8 xt1r9">-11</td>
			<td class="data" headers="xt1a2 xt1c3 xt1r8 xt1r9">-32</td>
			<td class="data" headers="">&nbsp;</td>
			<td class="data" headers="">&nbsp;</td>
			<td class="data" headers="xt1a4 xt1c6 xt1r8 xt1r9">-23</td>
			<td class="data" headers="xt1a4 xt1c7 xt1r8 xt1r9">-63</td>
		</tr>
		<tr>
			<th class="stub in1" headers="xt1c1 xt1r8" id="xt1r10"><em>OBBB</em></th>
			<td class="data" headers="xt1a2 xt1c2 xt1r8 xt1r10">8</td>
			<td class="data" headers="xt1a2 xt1c3 xt1r8 xt1r10">8</td>
