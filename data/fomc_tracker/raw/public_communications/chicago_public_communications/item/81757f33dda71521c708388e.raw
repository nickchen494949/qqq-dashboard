        <div class="cfedContentLimiter">
            <div class="row content-row">
                <div class="col">
                    <div id="content">
                        

    <div class="cfedDetail__content">

       
        <div class="cfedDetail__lastUpdated">Last Updated: 05/28/25</div>
                                    <div class="cfedDetail__title"><h1>Milwaukee Business Journal Mid-Year Outlook 2025</h1></div>

        <div class="cfedDetail__introduction"></div>
            </div>


    <div class="cfedContent">
        
        <div class="cfedContent__body">
            
                <div class="cfedContent__text">
<div class="calloutBox2023"><p>Federal Reserve Bank of Chicago President and CEO Austan Goolsbee participated in a moderated Q&A on June 23 at the Milwaukee Business Journal Mid-Year Outlook 2025 in Milwaukee, Wisconsin.</p></div></div>
                        


        </div>
    </div>


    <div class="cfedContent">
        
        <div class="cfedContent__body">
            
                <div class="cfedContent__text">
<!--<div data-experience="68506fce6e905b9a7726baac"></div>-->

<div style="display: block; position: relative; max-width: 100%;">
   <div style="padding-top: 56.25%;margin-bottom:5%">
        <iframe src="//players.brightcove.net/4934638106001/Sk7cO8ZDB_default/index.html?videoId=6374757658112" allowfullscreen="" style="left: 0px; top: 0px; width: 100%; height: 100%; right: 0px; bottom: 0px; position: absolute;" allow="encrypted-media" mozallowfullscreen="" webkitallowfullscreen="">
        </iframe>
    </div>
</div></div>
                        


        </div>
    </div>


                <script type="text/javascript">
                document.write('<scr'+'ipt type="text/javascript" src="https://players.brightcove.net/4934638106001/experience_68506fce6e905b9a7726baac/live.js" charset="utf-8"></scr'+'ipt>');
                </script>




<div class="row">
              <div class="col-xs-12 col-sm-6 cfedXs__padded" >

    <div class="detail-promo">

                <div class="detail-last-updated-mobile" style="display:none;">Last Updated: 11/21/2024</div>
                                    <div class="detail-promo-description"><div class="footerBox2023 leftColumn">
    <div class="cyan-section-header">Quick Links</div>
    <div class="footerBox2023-contents">
        <ul class="cfedList--bulleted">
    <li><a href="/utilities/about-us/office-of-the-president/office-of-the-president-home">Austan Goolsbee's Biography</a></li>
    <li><a href="/research/dual-mandate/dual-mandate">The Federal Reserve's Dual Mandate</a></li>
    <li><a href="/events/upcoming-events">Upcoming Events</a></li>
    <li><a href="/utilities/newsroom/newsroom-press-kit">Press Kit</a>
    </li>
    <li><a href="/utilities/newsroom/newsroom-home">Newsroom</a></li>
        </ul>
    </div>
</div></div>


        <div class="promo-link-list">
                <div class="link-container">


                </div>



        </div>
    </div>
</div>
    <div class="col-xs-12 col-sm-6 cfedXs__padded">

