                <script type="text/javascript">
                class PastEvents {
  constructor(endpoint, container, numEvents) {
    this.endpoint = endpoint;
    this.container = container;
    this.numEvents = numEvents;
  }

  async fetchData(numEvents) {
    try {
      const data = await fetch(this.endpoint).then((res) => res.json());
      return data.pastEvents.splice(0, numEvents);
    } catch (error) {
      console.error("Error: ", error);
    }
  }

  addPastEvents(pastEvents) {
    let pastEventHolder = this.container
      ? document.getElementById(this.container)
      : document.createElement("div");

    let pastEventsListWrapper = document.createElement("nav");
    pastEventsListWrapper.className = "pastEventsListWrapper";
    let pastEventsList = document.createElement("ul");
    pastEventsList.className = "pastEventsList";

    pastEvents.forEach((pastEvent) => {
      pastEventsList.append(this.createPastEventCard(pastEvent));
    });

    pastEventsListWrapper.append(pastEventsList);
    pastEventHolder.append(pastEventsListWrapper);
  }

  createPastEventCard(pastEvent) {
    let pastEventItemWrapper = document.createElement("li");
    pastEventItemWrapper.className = "pastEventItemWrapper";

    let pastEventItem = document.createElement("a");
    pastEventItem.className = "pastEventItem";
    pastEventItem.href = pastEvent.Url;

    pastEventItem.append(this.createTitleElement(pastEvent.Title));
    pastEventItem.append(this.createDateElement(pastEvent.Date));

    pastEventItemWrapper.append(pastEventItem);
    return pastEventItemWrapper;
  }

  createTitleElement(title) {
    let pastEventTitleElement = document.createElement("h2");
    pastEventTitleElement.className = "title";
    pastEventTitleElement.innerHTML = title;
    return pastEventTitleElement;
  }

  formatDate(date) {
    let [month, day, year] = date.split("/");
    switch (month) {
      case "01":
        month = "January";
        break;
      case "02":
        month = "February";
        break;
      case "03":
        month = "March";
        break;
      case "04":
        month = "April";
        break;
      case "05":
        month = "May";
        break;
      case "06":
        month = "June";
        break;
      case "07":
        month = "July";
        break;
      case "08":
        month = "August";
        break;
      case "09":
        month = "September";
        break;
      case "10":
        month = "October";
        break;
      case "11":
        month = "November";
        break;
      case "12":
        month = "December";
        break;
      default:
        month = "January";
        break;
    }
    if (day.length === 2) {
      if (day[0] === "0") {
        day = day[1];
      }
    }
    return `${month} ${day}, ${year}`
  }

  createDateElement(date) {
    let pastEventDateElement = document.createElement("span");
    pastEventDateElement.className = "date";
    pastEventDateElement.innerHTML = this.formatDate(date);
    return pastEventDateElement;
  }

  render() {
    this.fetchData(this.numEvents).then((res) => this.addPastEvents(res));
  }
}

function pastEventsDropdownOnChangeHandler(e) {
   if (e.target.value.startsWith('/')){ 
      window.location = e.target.value;
  }
}

function pastEventsDropdownReset() {
  const yearSelectDropdown = document.getElementById('year-select');
  yearSelectDropdown.selectedIndex = 0;
}


addEventListener('load', pastEventsDropdownReset);


addEventListener("DOMContentLoaded", () => {
  let pastevents = new PastEvents(
    `/forms/event/index`,
    "past-events-container",
    "4"
  );
  pastevents.render();
  
  const yearSelectDropdown = document.getElementById('year-select');
  yearSelectDropdown?.addEventListener('change', pastEventsDropdownOnChangeHandler);
});
                </script>


