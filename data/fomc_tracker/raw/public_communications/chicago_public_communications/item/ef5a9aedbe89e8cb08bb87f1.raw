    <div class="cfedContent">
        
        <div class="cfedContent__body">
            
                <div class="cfedContent__text"><style>
    :root {
      /* PRIMARY */
      --primary-navy: #042336;
      --primary-black: #0c0d0d;
      --primary-white: #fafcfc;
    
      /* SECONDARY */
      /* BLUE */
      --secondary-blue: #268cc3;
    
      /* LIGHT TEAL */
      --secondary-light-teal: #a0c4c5;
      --secondary-light-teal-100: #f6f9f9;
      --secondary-light-teal-200: #e7f0f1;
    
      /* ACCENT */
      /* NEON GREEN */
      --accent-neon-green: #2de9ca;
    
      /* NEON BLUE */
      --accent-neon-blue: #30d5ff;
    
      /* GRADIENT */
      --primary-gradient: linear-gradient(
        90deg,
        var(--accent-neon-blue) 0%,
        var(--accent-neon-green) 100%
      );
    }
    
    .cfedContent__text ul.year-button-container {
      padding: 0;
    }
    
    .year-button-container {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      gap: 1.3em;
    }
    
    .year-button-container li {
      display: block;
      width: 100%;
      border-radius: 3px;
    }
    
    .cfed-button {
      box-sizing: border-box;
      display: flex !important;
      justify-content: center;
      align-items: center;
      width: 100%;
      padding: 4px;
      border: 0;
      height: 52px;
      background-color: var(--secondary-light-teal-200);
      color: var(--secondary-blue);
      border-radius:1px;
    }
    
    .cfed-button:hover {
      box-sizing: border-box;
      background-color: var(--primary-navy);
      color: var(--primary-white);
      /*border-bottom-width: 3px;
      border-bottom-style: solid;
      border-image: var(--primary-gradient) 1;*/
      border-bottom: 3px solid #2BF3AF;
    }
    
    .year-select-dropdown {
      display: block;
      width: 100%;
      border: none;
      padding: 4px 8px;
      height: 52px;
      color: var(--primary-black);
      cursor: pointer;
      text-align: center;
      font-weight: 500;
    
      /* CUSTOM DROPDOWN ARROW */
      /* appearance: none;
      -moz-appearance: none;
      -webkit-appearance: none;
      background: var(--secondary-light-teal-200)
