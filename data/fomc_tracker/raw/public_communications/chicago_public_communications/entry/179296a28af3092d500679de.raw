    <div class="cfedContent">
        
        <div class="cfedContent__body">
            
                <div class="cfedContent__text"><div class="cfedContent__text">
    <div class="cfed-jacobsLadder">
        <div class="cfed-jLHeader containerHeader">
            Speeches by Year
        </div>
        <!-- Begin 2014 -->
        <div class="cfed-jLHeader yearHeader valuesExpanded">
            <a data-toggle="collapse" href="#cfedJL-2014" aria-expanded="true"
                aria-controls="cfedJL-2014">2014</a>
        </div>
        <div id="cfedJL-2014" class="cfed-jLValuesHolder collapse show">
            <div class="cfed-jLValues">
                <div class="cfed-jLValue">
                    <a href="/publications/speeches/2014/10-13-14-charles-evans-monetary-policy-normalization-national-council-teacher-retirement"
                        title="Monetary Policy Normalization: If Not Now, When?">Monetary Policy Normalization: If Not
                        Now, When?</a>
                </div>
                <div class="cfed-jLValue">
                    Presented at the National Council on Teacher Retirement 92nd Annual Conference in Indianapolis, IN
                </div>
                <div class="cfed-jLValue">
                    October 13
                </div>
                <div class="cfed-jLValue">
                    <a href="/-/media/publications/speeches/2014/10-13-14-monetary-policy-normalization-national-conference-teacher-retirement-print-pdf.pdf" title="Print Version">Print Version</a>
                </div>
            </div>
            <div class="cfed-jLValues">
                <div class="cfed-jLValue">
                    <a href="/publications/speeches/2014/10-08-14-charles-evans-monetary-policy-normalization-lakeland">Monetary Policy Normalization:
                        If Not Now, When?</a>
                </div>
                <div class="cfed-jLValue">
                    Presented at the BMO Harris and Lakeland College Economic Briefing in Plymouth, WI
                </div>
                <div class="cfed-jLValue">
                    October 8
                </div>
                <div class="cfed-jLValue">
                    <a href="/-/media/publications/speeches/2014/10-08-14-monetary-policy-normalization-lakeland-print-pdf.pdf">Print Version</a>
                </div>
            </div>
            <div class="cfed-jLValues">
                <div class="cfed-jLValue">
                    <a href="/publications/speeches/2014/09-29-14-charles-evans-patience-monetary-policy-nabe"
                        title="Is It Time to Return to Business-As-Usual Monetary Policy? A Case for Patience">Is It
                        Time to Return to Business-As-Usual Monetary Policy? A Case for Patience</a>
                </div>
                <div class="cfed-jLValue">
                    Presented at the 56th National Association for Business Economics Annual Conference
                </div>
                <div class="cfed-jLValue">
                    September 29
                </div>
                <div class="cfed-jLValue">
                    <a href="/-/media/publications/speeches/2014/09-29-2104-charles-evans-monetary-policy-patience-nabe-print-pdf.pdf" title="Print Version">Print Version</a>
