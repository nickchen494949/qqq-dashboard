<div class="article-intro article ">

        <div class="intro-image">
            <picture>
                                <img itemprop="image" src="/-/media/FRBP/Assets/Images/Pages/editorial-content/Newsroom/newsroom-bwcolumn-cb-lg.jpg" alt="Image of large column" />
