                </a>
            </li>
            <li class="share-circle-icon">
                <a href="mailto:?subject=Economic+Outlook%3a+Economic+Leadership+Forum&amp;body=https%3a%2f%2fwww.philadelphiafed.org%2fthe-economy%2fmonetary-policy%2f200117-economic-outlook-economic-leadership-forum" target="_blank">
                    <img src="/assets/images/svg/icon-utility/mail-circle.svg" alt="Email">
                </a>
            </li>
        </ul>
    </div>

