                <img itemprop="image" src="/-/media/FRBP/Assets/Images/content/Speeches/Harker-2/SubsectionBanner-Harker-2.png" alt="Federal Reserve Bank of Philadelphia President Patrick Harker speaking to an audience" />
            </picture>
