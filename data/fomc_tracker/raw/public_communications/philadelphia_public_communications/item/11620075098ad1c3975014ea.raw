                                <div class="card-content">
                                    <div class="eyebrow">
                                            <p class="topic-title">
                                                <a href="/consumer-finance/consumer-credit">Consumer Credit</a>
                                            </p>
                                        <p class="icon-type-label icon-type-brief">
                                            Brief
                                        </p>
                                    </div>
