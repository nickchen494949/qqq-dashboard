                    <img src="/assets/images/svg/icon-social/x-circle.svg" alt="X">
                </a>
            </li>
            <li class="share-circle-icon">
                <a href="https://www.facebook.com/sharer.php?u=https%3a%2f%2fwww.philadelphiafed.org%2fthe-economy%2fmonetary-policy%2f200115-monetary-policy-normalization-low-interest-rates-and-the-new-normal" target="_blank">
                    <img src="/assets/images/svg/icon-social/facebook-circle.svg" alt="Facebook">
                </a>
