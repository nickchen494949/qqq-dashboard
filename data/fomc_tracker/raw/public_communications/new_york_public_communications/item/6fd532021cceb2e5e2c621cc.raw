#myCookieConsent {
    z-index: 999;
    min-height: 20px;
    font-family: RobotoCondensedRegular;
    padding: 10px 20px;
    background: #3b4045;
    overflow: hidden;
    position: fixed;
    color: #FFF;
    bottom: 0px;
    display:none;
    right: 16px;
