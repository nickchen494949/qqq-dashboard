<td>
<div class="rightColIn"><span class="paraHeader"><a href="/medialibrary/media/newsevents/speeches/2011/dud111117_charts.pdf">Charts</a> <img src="/medialibrary/media/images/v2/icons/pdf.gif" alt="pdf"></span>
</div>
</td>
