    sessionStorage.setItem('bannerSeen',day);

   $("#cookieButton").click(function() {
 
       $("#myCookieConsent").fadeOut();
})
var expireTime = 24000*60*60; 
setTimeout(function() {
    sessionStorage.removeItem('bannerSeen');
}, expireTime);
} 
}); 

</script>
