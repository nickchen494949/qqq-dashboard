<script type="text/javascript">
$(document).ready(function(){   
var d = new Date(); 
var day = d.getDate(); 
if(sessionStorage.getItem('bannerSeen') != day){
    $("#myCookieConsent").fadeIn();
    sessionStorage.setItem('bannerSeen',day);

   $("#cookieButton").click(function() {
 
       $("#myCookieConsent").fadeOut();
})
