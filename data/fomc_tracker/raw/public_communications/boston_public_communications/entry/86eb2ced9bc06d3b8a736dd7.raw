<div>
    <style>
  footer {
    font-family: 'Open Sans', Arial, Helvetica, sans-serif;
    background-color: #1262b2;
    color: #fff;
    margin-top: 40px;
  }
  footer .container {
    margin-right: auto;
    margin-left: auto;
  }
  @media (min-width: 1200px) {
    footer .container {
      width: 1190px;
      padding-left: 25px;
      padding-right: 25px;
    }
  }
  footer .container #links-row {
    display: flex;
    gap: 15px;
  }
  #links-row .links-container {
    min-width: 15%;
    flex: 1;
  }
  #social-row ul {
    display: flex;
    flex-direction: row-reverse;
  }
  #social-row ul li {
    text-align: right;
  }
  .email-updates {
    text-align: right;
  }
  .visitor-info {
    display: flex;
    /* float right */
    margin-left: auto;
    flex-shrink: 0;
  }
  .footer-img-container {
    border-radius: 100%;
    overflow: hidden;
    height: 100px;
    width: 100px;
    border: 3px solid white;
    margin-left: 20px;
    padding-top: 0px;
    flex-shrink: 0;
  }
  .footer-img-container img {
    object-fit: contain;
  }
  .footer-links li,
  address {
    color: #fff;
    font-size: 16px;
    font-weight: 300;
    line-height: 19px;
    margin-bottom: 10px;
    text-decoration: none;
    font-style: normal;
  }
  .footer-directions-text {
    text-align: right;
  }
  .footer-sections-container {
    margin-top: 20px;
  }
  .footer-sections-container a {
    color: #fff;
  }
  .footer-sections-container h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 15px;
  }
  .footer-utility-container {
    color: #ffffff;
    font-size: 13px;
    font-weight: 300;
  }
  .footer-utility-container-row li {
    margin-right: 25px;
  }
  .footer-utility-container-row li:last-child {
    margin-right: 0px;
  }
  .footer-utility-inner {
    border-top: 1px solid #add8e6;
    padding-top: 15px;
  }
  .footer-utility-list {
    margin-bottom: 0;
    margin-left: 0;
  }
  .footer-utility-list > li {
    padding-left: 0;
    padding-right: 0;
  }
  .img-thumbnail {
    padding: 2px;
  }
  .section-container {
    margin-bottom: 25px;
  }
  .social-links {
    margin: 20px 0;
  }
  .social-links img {
    height: 35px;
    width: 35px;
  }
  .social-links li a {
    display: block;
    height: 40px;
    width: 40px;
  }
  .social-links p {
    margin-bottom: 0;
  }
  .social-links .svg.social-icon {
    vertical-align: middle;
  }
  .get-updates-link-container {
    color: #ffffff;
    font-size: 16px;
    font-weight: 300;
    line-height: 19px;
  }
  .tweet-container {
    display: table-cell;
    vertical-align: middle;
  }
  .tweet-container-wrapper {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    color: #000;
    text-align: left;
  }
  address .open-map,
  .footer-tweets .fa-stack {
    color: #ffffff;
  }
  address li {
    margin-bottom: 5px;
  }
  address ul {
    margin-bottom: 15px;
  }
  @media (min-width: 320px) {
    footer #links-row {
      flex-direction: column;
    }
    .footer-wrapper-row {
      padding-left: 5%;
      padding-right: 5%;
    }
    .visitor-info {
      flex-direction: column-reverse;
      align-items: end;
    }
    footer .footer-wrapper-row {
      padding-top: 25px;
      padding-left: 3%;
      padding-right: 3%;
    }
    .footer-tweets {
      width: 95%;
    }
    .footer-tweets-tweet {
      margin-left: 0;
    }
    .footer-utility {
      text-align: left;
    }
    .footer-utility-container-row li {
      display: block;
      margin-bottom: 20px;
    }
    .footer-utility-copyright {
      margin-left: auto;
    }
    .social-links {
      font-size: 16px;
      font-weight: 300;
      line-height: 19px;
    }
    .social-links a {
      color: #fff;
    }
    .tweet-container-wrapper {
      width: 80%;
      word-break: break-all;
    }
  }
  @media (min-width: 768px) {
    .footer-wrapper-row {
      padding-left: 5%;
      padding-right: 5%;
    }
    .visitor-info {
      flex-direction: row;
      align-items: unset;
    }
    .footer-tweets {
      width: 75%;
    }
    .footer-utility {
      text-align: right;
    }
    .footer-utility-container-row li {
      display: inline-block;
    }
    .footer-utility-copyright {
      clear: none;
      display: inline;
      float: right;
      text-align: right;
    }
  }
  @media (min-width: 992px) {
    footer #links-row {
      flex-direction: row;
    }
    .footer-sections-container {
      padding-left: 0;
    }
    .footer-tweets {
      width: 60%;
    }
  }
</style>
