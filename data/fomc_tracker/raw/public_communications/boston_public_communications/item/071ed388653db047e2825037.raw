<script>
  window.addEventListener('load', (event) => {

    var FRB = FRB || {};
    FRB.header =
      FRB.header ||
      (function () {
        // Variables Define
        let $body = document.querySelector("body");
        let $header = document.querySelector("#header");
        let $navBar = document.querySelector(".navbar");
        let $topMenu = document.querySelector(".nav-top-section");
        let $bottomMenu = document.querySelector(".nav-bottom-section");

        let $navToggleMenu = $header.querySelector(".navbar-toggle-mobile-menu");
        let $navToggleIcnClose = $navToggleMenu.querySelector(".mme-close");
        let $navToggleIcnOpen = $navToggleMenu.querySelector(".mme-open");

        let $navSearch = $header.querySelector(".navbar-search");
        let $navSearchImg = $navSearch.querySelector("img");
        let $searchContainer = document.querySelector("#search-container");
        let $searchInput = document.querySelector("#search-container #s");

        const scrollThreshold = 300;
        let currentScrollY = 0;
        // Initial State

        // Methods
        function calculateHeight($div) {
          const $clonedDiv = $div.cloneNode(true);
          $clonedDiv.style.visibility = "hidden";
          $clonedDiv.style.height = "auto";
          $clonedDiv.style.display = "block";
          $div.parentNode.appendChild($clonedDiv);
          const height = $clonedDiv.offsetHeight;
          $clonedDiv.remove();
          return height;
        }

        function throttle(fn, delay) {
          let lastCall = 0;
          return function (...args) {
            const now = Date.now();
            // Check if enough time has passed since the last call
            if (now - lastCall >= delay) {
              lastCall = now;
              fn.apply(this, args); // Execute the original function
            }
          };
        }

        function collapseMenu() {
          $body.classList.remove("nav-expanded");
          $header.classList.remove("expanded");
          $bottomMenu.style.height = '';
        }

        function expandMenu() {
          $body.classList.add("nav-expanded");
          $header.classList.add("expanded");

          let maxHeight = calculateHeight($bottomMenu);
          $bottomMenu.style.visibility = "visible"
          $bottomMenu.style.height = "auto";
        }

        function toggleMenu() {
          if (window.innerWidth > 990) return;

          var isExpanded = $body.classList.contains("nav-expanded");
          closeSearch();

          if (isExpanded) {
            collapseMenu();
          } else {
            expandMenu();
          }
        }

        function openSearch() {
          const navAutoHeight = calculateHeight($header);

          $body.classList.add("search-active");
          if ($searchContainer) {
            $searchContainer.style.display = "block";
            $searchContainer.style['top'] = navAutoHeight + "px";
          }

          if($searchInput) {
            $searchInput.placeholder = "Search";
            $searchInput.focus();
          }

          let searchOpenEvent = new Event("search-open");
          document.dispatchEvent(searchOpenEvent);
        }

        function closeSearch() {
          $body.classList.remove("search-active");
          if ($searchContainer) $searchContainer.style.display = "none";
          let searchOpenEvent = new Event("search-open");
          document.dispatchEvent(searchOpenEvent);
        }

        function toggleSearch() {
          collapseMenu();
          let isSearchActive = $body.classList.contains("search-active");
          if (isSearchActive) {
            closeSearch();
          } else {
            openSearch();
          }
        }

        function hideDesktopBottomMenu() {
          $bottomMenu.style.height = "";
        }

        function showDesktopBottomMenu() {
          const bNavAutHeight = calculateHeight($bottomMenu);
          $bottomMenu.style.height = bNavAutHeight + "px"
        }

        const checkScrollPosition = throttle(() => {

          if (window.innerWidth < 990) return;
          let isScrollingDown = window.scrollY > currentScrollY ? true : false;

          if (isScrollingDown) {

          } else {

          }
          currentScrollY = window.scrollY;
        }, 300)

        function init() {
          let navTotalHeight = 10;
        }

        // Event Handlers

        window.addEventListener('scroll', checkScrollPosition);

        $navToggleMenu.addEventListener("click", () => {
          toggleMenu();
        });

        $navSearch.addEventListener("click", () => {
          toggleSearch();
        });

        checkScrollPosition();
        init();




        return {
          toggleMenu: toggleMenu,
          expandMenu: expandMenu,
          collapseMenu: collapseMenu,
          hideDesktopBottomMenu: hideDesktopBottomMenu,
          showDesktopBottomMenu: showDesktopBottomMenu
        };
      })();

  });
</script>

