    display: flex;
    gap: 15px;
  }
  #links-row .links-container {
    min-width: 15%;
    flex: 1;
  }
  #social-row ul {
    display: flex;
    flex-direction: row-reverse;
  }
  #social-row ul li {
    text-align: right;
  }
  .email-updates {
    text-align: right;
  }
  .visitor-info {
    display: flex;
    /* float right */
    margin-left: auto;
    flex-shrink: 0;
  }
  .footer-img-container {
    border-radius: 100%;
    overflow: hidden;
    height: 100px;
    width: 100px;
    border: 3px solid white;
    margin-left: 20px;
    padding-top: 0px;
    flex-shrink: 0;
  }
  .footer-img-container img {
    object-fit: contain;
  }
  .footer-links li,
  address {
    color: #fff;
    font-size: 16px;
    font-weight: 300;
    line-height: 19px;
    margin-bottom: 10px;
    text-decoration: none;
    font-style: normal;
  }
  .footer-directions-text {
    text-align: right;
